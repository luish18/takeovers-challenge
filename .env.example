# .env.example — names only, never commit real keys.
# Only needed to re-run extraction; `uv run actes build` works from the committed cache without any key.
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-sonnet-5 / claude-opus-5)
ACTES_EXTRACT_MODEL=
ACTES_REVIEW_MODEL=
# Optional: which prompt's cached responses to use (default extract_v2; extract_v1 reproduces the first run)
ACTES_PROMPT_VERSION=
# Optional: path to engineering-challenges/data if the submodule is not initialised
ACTES_DATA_DIR=
